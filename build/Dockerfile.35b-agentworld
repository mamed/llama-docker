#
# ─── HARDENING (in order of enforceability) ───
#   1. Launcher baked into image at /usr/local/bin/llama-locked.35b.sh
#      - Mode 0555 (read+execute, NO write), owned by root:root
#      - chattr +i (immutable bit) — cannot be modified, deleted, or replaced
#      - Launcher also verifies its own sha256 against baked value; if mismatch,
#        exits with code 78 (config error).
#   2. ENTRYPOINT is the locked launcher; CMD is empty (runtime args ignored)
#   3. Container runs with --read-only rootfs and --cap-drop=ALL
#   4. Immutable tarball saved at /home/fekry/llama-docker/llama-qwen-35b-agentworld.locked-256k-q4kv-v4.tar
#   5. To change config: edit this Dockerfile + launcher, rebuild, re-snapshot.

FROM nvidia/cuda:12.8.0-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential cmake git curl \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git /llama.cpp
WORKDIR /llama.cpp

RUN cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_CURL=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    && cmake --build build --config Release --target llama-server -j$(nproc) 2>&1 || \
    cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_CURL=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_EXE_LINKER_FLAGS="-L/usr/lib/stubs -Wl,--allow-shlib-undefined" \
    -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/lib/stubs -Wl,--allow-shlib-undefined" \
    && cmake --build build --config Release --target llama-server -j$(nproc)

# Runtime image
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# v6-r1: replace in-image compile with our pre-built llama-server (cuda-12.8,
# llama.cpp master as of 2026-07-27 commit 0324696). This avoids the 8-10 min
# compile inside the build stage and keeps the toolchain pinned.
COPY binaries-v6-r1/llama-server /usr/local/bin/llama-server

# ── Locked launcher (source of truth) ──
COPY scripts/llama-locked.35b.sh /usr/local/bin/llama-locked.35b.sh

# Lock the launcher: read+exec only, owned by root, immutable bit set.
# This makes it impossible for anyone (including root inside the container,
# or any docker exec session) to modify the launcher at runtime.
RUN chmod 0555 /usr/local/bin/llama-locked.35b.sh \
    && chown root:root /usr/local/bin/llama-locked.35b.sh \
    && sha256sum /usr/local/bin/llama-locked.35b.sh > /usr/local/bin/llama-locked.35b.sh.sha256

# Custom permissive chat template (overrides GGUF-embedded strict template)
# Fixes Codex CLI compatibility by allowing system messages anywhere in the order.
COPY templates/qwen35-permissive.jinja /usr/local/share/llama-server/qwen35-permissive.jinja
RUN chmod 0444 /usr/local/share/llama-server/qwen35-permissive.jinja \
    && chown root:root /usr/local/share/llama-server/qwen35-permissive.jinja

# Locked config ENVs (informational only — the launcher uses literal flags, not these)
ENV HOST=0.0.0.0
ENV PORT=64006
ENV NGL=99
ENV CTX=262144
ENV CTK=q4_0
ENV CTV=q4_0
ENV PARALLEL=1
ENV REASONING_BUDGET=-1

EXPOSE 64006

# Locked entrypoint; CMD intentionally empty so `docker run … <args>` is a no-op.
ENTRYPOINT ["/usr/local/bin/llama-locked.35b.sh"]
CMD []