# Qwen2.5-Coder-14B-Instruct — Q4_K_M, 128K context
# Image: llama-qwen-14b-coder:latest
# HARDENED: All flags baked into locked launcher. Runtime overrides ignored.
# Port: 64005 | Config: -ngl 99, ctx 49152 (48K), q4_0 KV, reasoning unlimited, agent
# Hardware: 12 GB GPU. 128K is the model's max (YaRN-extended from native 32K).
# May need to reduce ctx if 128K OOMs at this hardware tier.
# Reasoning budget -1 (unlimited) to match the rest of the fleet.
# All args baked via locked launcher: /usr/local/bin/llama-locked.14b.sh
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential cmake git curl \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git /llama.cpp
WORKDIR /llama.cpp

RUN cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_CURL=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    && cmake --build build --config Release --target llama-server -j$(nproc) 2>&1 || \
    cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_CURL=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_EXE_LINKER_FLAGS="-L/usr/lib/stubs -Wl,--allow-shlib-undefined" \
    -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/lib/stubs -Wl,--allow-shlib-undefined" \
    && cmake --build build --config Release --target llama-server -j$(nproc)

# Runtime image
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /llama.cpp/build/bin/llama-server /usr/local/bin/
COPY scripts/llama-locked.14b.sh /usr/local/bin/llama-locked.14b.sh
RUN chmod +x /usr/local/bin/llama-locked.14b.sh

# ─── Model config baked in ───
ENV HOST=0.0.0.0
ENV PORT=64005
ENV NGL=99
ENV CTX=49152
ENV CTK=q4_0
ENV CTV=q4_0
ENV PARALLEL=1
ENV REASONING_BUDGET=-1

EXPOSE 64005

ENTRYPOINT ["/usr/local/bin/llama-locked.14b.sh"]
CMD ["-m", "/models/unsloth/Qwen2.5-Coder-14B-Instruct-Q4_K_M/Qwen2.5-Coder-14B-Instruct-Q4_K_M.gguf", \
     "--host", "0.0.0.0", "--port", "64005", \
     "-ngl", "99", "--ctx-size", "131072", \
     "-ctk", "q4_0", "-ctv", "q4_0", \
     "--parallel", "1", "--cont-batching", \
     "-fa", "on", \
     "--reasoning", "on", "--reasoning-budget", "-1", \
     "--agent"]
