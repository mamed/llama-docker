# Qwen2.5-Coder-7B-Instruct — Q8_0, 128K context
# Image: llama-qwen-7b-coder:latest
# HARDENED: All flags baked into locked launcher. Runtime overrides ignored.
# Port: 64004 | Config: -ngl 99, ctx 131072 (128K), q8_0 KV, reasoning unlimited, agent
# Architecture: qwen2 — 28 layers, 28 attn heads, 4 KV heads, head_dim 128.
# 7.54 GB on disk. RoPE YaRN factor 4.0, original ctx 32K, extended max 128K.
# No tool-call training — pure coder (same as 14B).
# On 12 GB GPU: 7.54 GB model + 1.88 GB KV at 128K q8_0 = ~9.4 GB → ~2.6 GB free.
# Reasoning budget -1 (unlimited) to match the rest of the fleet.
# All args baked via locked launcher: /usr/local/bin/llama-locked.7b.sh
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential cmake git curl \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git /llama.cpp
WORKDIR /llama.cpp

RUN cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_CURL=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    && cmake --build build --config Release --target llama-server -j$(nproc) 2>&1 || \
    cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_CURL=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_EXE_LINKER_FLAGS="-L/usr/lib/stubs -Wl,--allow-shlib-undefined" \
    -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/lib/stubs -Wl,--allow-shlib-undefined" \
    && cmake --build build --config Release --target llama-server -j$(nproc)

# Runtime image
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /llama.cpp/build/bin/llama-server /usr/local/bin/
COPY scripts/llama-locked.7b.sh /usr/local/bin/llama-locked.7b.sh
RUN chmod +x /usr/local/bin/llama-locked.7b.sh

# ─── Model config baked in ───
ENV HOST=0.0.0.0
ENV PORT=64004
ENV NGL=99
ENV CTX=131072
ENV CTK=q8_0
ENV CTV=q8_0
ENV PARALLEL=1
ENV REASONING_BUDGET=-1

EXPOSE 64004

ENTRYPOINT ["/usr/local/bin/llama-locked.7b.sh"]
CMD ["-m", "/models/unsloth/Qwen2.5-Coder-7B-Instruct-Q8_0/Qwen2.5-Coder-7B-Instruct-Q8_0.gguf", \
     "--host", "0.0.0.0", "--port", "64004", \
     "-ngl", "99", "--ctx-size", "131072", \
     "-ctk", "q8_0", "-ctv", "q8_0", \
     "--parallel", "1", "--cont-batching", \
     "-fa", "on", \
     "--jinja", \
     "--reasoning-budget", "-1", \
     "--agent"]
